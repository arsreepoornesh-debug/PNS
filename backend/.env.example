# =========================================================
# AI Resume Analyzer — Backend Environment Variables
# Copy this file to .env and fill in your values
# =========================================================

# ── Database ───────────────────────────────────────────
# Local SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./resume_analyzer.db

# Supabase PostgreSQL (recommended for cloud):
# Get from: Supabase project → Settings → Database → Connection string → URI
# IMPORTANT: replace "postgres://" with "postgresql+asyncpg://"
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Security ───────────────────────────────────────────
# CHANGE THIS in production! Generate with: openssl rand -hex 32
SECRET_KEY=supersecret_ai_resume_analyzer_key_change_in_prod

# ── AI Provider ───────────────────────────────────────────
# Options: "groq" | "ollama" | "rule_based"
DEFAULT_AI_PROVIDER=groq

# Groq (FREE — 30 req/min, 6000 tokens/min)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama (local dev only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ── CORS ────────────────────────────────────────────────
# Add your Vercel frontend URL to allow cross-origin requests
# BACKEND_CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
